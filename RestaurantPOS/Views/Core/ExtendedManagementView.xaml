<UserControl x:Class="RestaurantPOS.Views.Core.ExtendedManagementView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <UserControl.Resources><BooleanToVisibilityConverter x:Key="Bool"/><Style TargetType="TextBox"><Setter Property="Margin" Value="0,2,0,7"/><Setter Property="Padding" Value="5"/></Style><Style TargetType="Button"><Setter Property="Padding" Value="10,5"/><Setter Property="Margin" Value="2"/></Style></UserControl.Resources>
 <DockPanel>
  <Border DockPanel.Dock="Bottom" Background="#E8EEF8" Padding="10"><TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap"/></Border>
  <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8"><TextBlock Text="QUẢN LÝ NGHIỆP VỤ MỞ RỘNG" FontSize="20" FontWeight="Bold"/><Button Content="Làm mới" Command="{Binding RefreshCommand}" Margin="20,0,0,0"/></StackPanel>
  <TabControl>
   <TabItem Header="Nhân viên" Visibility="{Binding IsManager,Converter={StaticResource Bool}}"><Grid Margin="8"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><DataGrid ItemsSource="{Binding Employees}" SelectedItem="{Binding SelectedEmployee}" IsReadOnly="True" AutoGenerateColumns="True"/><StackPanel Grid.Column="1" Margin="12"><Button Content="Nhân viên mới" Command="{Binding NewEmployeeCommand}"/><TextBlock Text="Họ tên"/><TextBox Text="{Binding SelectedEmployee.FullName}"/><TextBlock Text="Tài khoản"/><TextBox Text="{Binding SelectedEmployee.Username}"/><TextBlock Text="Mật khẩu mới"/><TextBox Text="{Binding NewPassword}"/><TextBlock Text="Vai trò"/><ComboBox ItemsSource="{Binding Roles}" SelectedItem="{Binding SelectedEmployee.Role}"/><StackPanel Orientation="Horizontal" Margin="0,8"><Button Content="Lưu" Command="{Binding SaveEmployeeCommand}"/><Button Content="Khóa/Mở" Command="{Binding ToggleEmployeeCommand}"/></StackPanel></StackPanel></Grid></TabItem>
   <TabItem Header="Thực đơn" Visibility="{Binding IsManager,Converter={StaticResource Bool}}"><Grid Margin="8"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><DataGrid ItemsSource="{Binding Dishes}" SelectedItem="{Binding SelectedDish}" IsReadOnly="True" AutoGenerateColumns="True"/><StackPanel Grid.Column="1" Margin="12"><Button Content="Món mới" Command="{Binding NewDishCommand}"/><TextBlock Text="Tên món"/><TextBox Text="{Binding SelectedDish.DishName}"/><TextBlock Text="Giá"/><TextBox Text="{Binding SelectedDish.Price}"/><TextBlock Text="Danh mục"/><ComboBox ItemsSource="{Binding Categories}" DisplayMemberPath="CategoryName" SelectedValuePath="CategoryId" SelectedValue="{Binding SelectedDish.CategoryId}"/><TextBlock Text="Trạng thái"/><ComboBox ItemsSource="{Binding DishStatuses}" SelectedItem="{Binding SelectedDish.AvailabilityStatus}"/><Button Content="Lưu món" Command="{Binding SaveDishCommand}"/><Separator Margin="0,8"/><Button Content="Danh mục mới" Command="{Binding NewCategoryCommand}"/><ComboBox ItemsSource="{Binding Categories}" DisplayMemberPath="CategoryName" SelectedItem="{Binding SelectedCategory}"/><TextBox Text="{Binding SelectedCategory.CategoryName}"/><Button Content="Lưu danh mục" Command="{Binding SaveCategoryCommand}"/></StackPanel></Grid></TabItem>
   <TabItem Header="Bàn" Visibility="{Binding IsManager,Converter={StaticResource Bool}}"><Grid Margin="8"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><DataGrid ItemsSource="{Binding Tables}" SelectedItem="{Binding SelectedTable}" IsReadOnly="True" AutoGenerateColumns="True"/><StackPanel Grid.Column="1" Margin="12"><Button Content="Bàn mới" Command="{Binding NewTableCommand}"/><TextBlock Text="Tên bàn"/><TextBox Text="{Binding SelectedTable.TableName}"/><TextBlock Text="Khu vực"/><TextBox Text="{Binding SelectedTable.Area}"/><TextBlock Text="Sức chứa"/><TextBox Text="{Binding SelectedTable.Capacity}"/><CheckBox Content="Đang sử dụng" IsChecked="{Binding SelectedTable.IsActive}"/><Button Content="Lưu bàn" Command="{Binding SaveTableCommand}"/></StackPanel></Grid></TabItem>
   <TabItem Header="Đặt bàn" Visibility="{Binding CanManageReservations,Converter={StaticResource Bool}}"><Grid Margin="8"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><DataGrid ItemsSource="{Binding Reservations}" SelectedItem="{Binding SelectedReservation}" IsReadOnly="True" AutoGenerateColumns="True"/><ScrollViewer Grid.Column="1"><StackPanel Margin="12"><Button Content="Đặt bàn mới" Command="{Binding NewReservationCommand}"/><TextBlock Text="Khách hàng"/><ComboBox ItemsSource="{Binding Customers}" DisplayMemberPath="FullName" SelectedValuePath="CustomerId" SelectedValue="{Binding SelectedReservation.CustomerId}"/><GroupBox Header="Tạo nhanh khách mới" Margin="0,8"><StackPanel Margin="6"><TextBox Text="{Binding QuickCustomerName}" ToolTip="Tên khách"/><TextBox Text="{Binding QuickCustomerPhone}" ToolTip="Số điện thoại"/><Button Content="Tạo và chọn khách" Command="{Binding CreateQuickCustomerCommand}"/></StackPanel></GroupBox><TextBlock Text="Bàn"/><ComboBox ItemsSource="{Binding Tables}" DisplayMemberPath="TableName" SelectedValuePath="TableId" SelectedValue="{Binding SelectedReservation.TableId}"/><TextBlock Text="Ngày đặt"/><DatePicker SelectedDate="{Binding ReservationDate}" SelectedDateFormat="Short"/><TextBlock Text="Giờ đặt"/><StackPanel Orientation="Horizontal"><ComboBox Width="90" ItemsSource="{Binding ReservationHours}" SelectedItem="{Binding ReservationHour}"/><TextBlock Text=":" FontSize="18" VerticalAlignment="Center" Margin="8,0"/><ComboBox Width="90" ItemsSource="{Binding ReservationMinutes}" SelectedItem="{Binding ReservationMinute}"/></StackPanel><TextBlock Text="Số khách"/><TextBox Text="{Binding SelectedReservation.GuestCount}"/><TextBlock Text="Ghi chú"/><TextBox Text="{Binding SelectedReservation.Note}"/><Button Content="Lưu đặt bàn" Command="{Binding SaveReservationCommand}"/><StackPanel Orientation="Horizontal"><Button Content="Nhận bàn" Command="{Binding CheckInCommand}"/><Button Content="Hủy đặt" Command="{Binding CancelReservationCommand}"/></StackPanel></StackPanel></ScrollViewer></Grid></TabItem>
   <TabItem Header="Điều chỉnh kho" Visibility="{Binding CanManageStock,Converter={StaticResource Bool}}"><Grid Margin="8"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><DataGrid ItemsSource="{Binding StockMovements}" IsReadOnly="True" AutoGenerateColumns="True"/><StackPanel Grid.Column="1" Margin="12"><TextBlock Text="Nguyên liệu"/><ComboBox ItemsSource="{Binding Ingredients}" DisplayMemberPath="IngredientName" SelectedItem="{Binding SelectedIngredient}"/><TextBlock Text="Số lượng"/><TextBox Text="{Binding AdjustmentQuantity}"/><TextBlock Text="Lý do"/><TextBox Text="{Binding Reason}"/><Button Content="Điều chỉnh tăng" Command="{Binding AdjustInCommand}"/><Button Content="Điều chỉnh giảm" Command="{Binding AdjustOutCommand}"/><Button Content="Xuất hủy" Command="{Binding WasteCommand}"/></StackPanel></Grid></TabItem>
   <TabItem Header="Hóa đơn" Visibility="{Binding CanViewInvoices,Converter={StaticResource Bool}}"><Grid Margin="8"><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DataGrid ItemsSource="{Binding Invoices}" SelectedItem="{Binding SelectedInvoice}" IsReadOnly="True" AutoGenerateColumns="True"/><StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8"><TextBox Width="350" Text="{Binding Reason}" ToolTip="Lý do hủy"/><Button Content="In hóa đơn" Command="{Binding PrintInvoiceCommand}"/><Button Content="Hủy hóa đơn (manager)" Command="{Binding CancelInvoiceCommand}"/></StackPanel></Grid></TabItem>
   <TabItem Header="Nhật ký" Visibility="{Binding IsManager,Converter={StaticResource Bool}}"><DataGrid ItemsSource="{Binding AuditLogs}" IsReadOnly="True" AutoGenerateColumns="True" Margin="8"/></TabItem>
  </TabControl>
 </DockPanel>
</UserControl>
